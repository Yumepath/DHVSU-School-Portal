{
  "name": "dhvsu-school-portal",
  "version": "1.0.0",
  "author": "Christian Lao Bautista",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "prestart": "node scripts/configure.mjs",
    "prebuild": "node scripts/configure.mjs",
    "check": "node scripts/configure.mjs && ngc --noEmit -p tsconfig.app.json",
    "test:browser": "playwright test",
    "seed:demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "bootstrap:admin": "node --env-file-if-exists=.env scripts/bootstrap.mjs",
    "preview": "node scripts/preview.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@fullcalendar/angular": "6.1.20",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@ionic/angular": "8.8.21",
    "@supabase/supabase-js": "2.119.2",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.31",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@angular/language-service": "21.2.26",
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "type": "module"
}
